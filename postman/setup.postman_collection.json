    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set default variables if not already set",
                    "if (!pm.collectionVariables.get('pnlp')) {",
                    "    pm.collectionVariables.set('pnlp', 'http://localhost:8000');",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Basic response validation",
                    "pm.test('Status code should be 2xx or 4xx for expected errors', function () {",
                    "    pm.expect(pm.response.code).to.be.at.least(200);",
                    "    pm.expect(pm.response.code).to.be.below(500);",
                    "});",
                    "",
                    "// Check for JSON response",
                    "pm.test('Response should be JSON', function () {",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "// Parse and validate response structure",
                    "pm.test('Response has expected structure', function () {",
                    "    const responseJson = pm.response.json();",
                    "    ",
                    "    // All setup operations should have these fields",
                    "    if (pm.request.method === 'POST') {",
                    "        pm.expect(responseJson).to.have.property('success');",
                    "        if (responseJson.operation_metadata) {",
                    "            pm.expect(responseJson.operation_metadata).to.have.property('duration_seconds');",
                    "            pm.expect(responseJson.operation_metadata).to.have.property('timestamp');",
                    "        }",
                    "    }",
                    "});",
                    "",
                    "// Log response for debugging",
                    "console.log('Response Status:', pm.response.status);",
                    "console.log('Response Time:', pm.response.responseTime + 'ms');",
                    "",
                    "// Log response body for POST operations",
                    "if (pm.request.method === 'POST') {",
                    "    console.log('Response Body:', JSON.stringify(pm.response.json(), null, 2));",
                    "}"
                ]
            }
        }
    ]
