{
    "info": {
        "name": "Polymer NLP Extractor - Models Sync API",
        "description": "Comprehensive Models Synchronization API collection for GitHub-based models and tokenizers management without authentication",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "polymer-models-api-2024",
        "version": {
            "major": 2,
            "minor": 0,
            "patch": 0
        }
    },
    "variable": [
        {
            "key": "pnlp",
            "value": "http://localhost:8000",
            "description": "Base URL for Polymer NLP Extractor API"
        }
    ],
    "item": [
        {
            "name": "Models Status & Monitoring",
            "description": "Monitor models directory and sync configuration status",
            "item": [
                {
                    "name": "Get Models Status",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{pnlp}}/api/models/status",
                            "host": ["{{pnlp}}"],
                            "path": ["api", "models", "status"]
                        },
                        "description": "Get current status of models directory and GitHub sync configuration. Provides comprehensive status information about the current models directory, GitHub configuration, and sync readiness. Useful for debugging and monitoring."
                    },
                    "response": []
                },
                {
                    "name": "Validate Models Versions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{pnlp}}/api/models/validate",
                            "host": ["{{pnlp}}"],
                            "path": ["api", "models", "validate"]
                        },
                        "description": "Validate version compatibility between existing models and tokenizers. Checks all models and tokenizers in the models directory for version compatibility and structural completeness. Provides detailed analysis of each model-tokenizer pair."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Models Synchronization",
            "description": "Core models sync operations from GitHub repositories",
            "item": [
                {
                    "name": "Sync Models (Safe)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"force_redownload\": false\n}"
                        },
                        "url": {
                            "raw": "{{pnlp}}/api/models/sync",
                            "host": ["{{pnlp}}"],
                            "path": ["api", "models", "sync"]
                        },
                        "description": "Safe synchronization of models and tokenizers from GitHub repositories. Downloads latest models and tokenizers from configured GitHub repositories, validates version compatibility, and updates local models directory atomically. Only downloads if not already present."
                    },
                    "response": []
                },
                {
                    "name": "Sync Models (Force Redownload)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"force_redownload\": true\n}"
                        },
                        "url": {
                            "raw": "{{pnlp}}/api/models/sync",
                            "host": ["{{pnlp}}"],
                            "path": ["api", "models", "sync"]
                        },
                        "description": "Force redownload and synchronization of models and tokenizers from GitHub repositories. Downloads latest models and tokenizers even if they already exist locally. Useful for updating to latest versions or recovering from corruption."
                    },
                    "response": []
                }
            ]
        },
