    "auth": {
        "type": "noauth"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set default variables if not already set",
                    "if (!pm.collectionVariables.get('pnlp')) {",
                    "    pm.collectionVariables.set('pnlp', 'http://localhost:8000');",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Basic response validation for models API",
                    "pm.test('Status code should be appropriate for models operations', function () {",
                    "    // 200 for successful GET operations",
                    "    // 200/201 for successful POST operations", 
                    "    // 422 for configuration errors (missing GitHub token, etc.)",
                    "    // 500 for internal server errors",
                    "    const expectedCodes = [200, 201, 422, 500];",
                    "    pm.expect(expectedCodes).to.include(pm.response.code);",
                    "});",
                    "",
                    "// Check for JSON response",
                    "pm.test('Response should be JSON', function () {",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "// Parse and validate response structure based on endpoint",
                    "pm.test('Response has expected structure for models API', function () {",
                    "    const responseJson = pm.response.json();",
                    "    const url = pm.request.url.toString();",
                    "    ",
                    "    // Models sync endpoint validation",
                    "    if (url.includes('/api/models/sync') && pm.request.method === 'POST') {",
                    "        if (pm.response.code === 200) {",
                    "            pm.expect(responseJson).to.have.property('success');",
                    "            pm.expect(responseJson).to.have.property('models_synced');",
                    "            pm.expect(responseJson).to.have.property('tokenizers_synced');",
                    "            pm.expect(responseJson).to.have.property('version_validated');",
                    "            pm.expect(responseJson).to.have.property('duration_seconds');",
                    "        } else if (pm.response.code === 422) {",
                    "            pm.expect(responseJson).to.have.property('detail');",
                    "            pm.expect(responseJson.detail).to.have.property('message');",
                    "            pm.expect(responseJson.detail).to.have.property('errors');",
                    "        }",
                    "    }",
                    "    ",
                    "    // Models status endpoint validation",
                    "    if (url.includes('/api/models/status') && pm.request.method === 'GET') {",
                    "        pm.expect(responseJson).to.have.property('models_directory_exists');",
                    "        pm.expect(responseJson).to.have.property('models_count');",
                    "        pm.expect(responseJson).to.have.property('tokenizers_count');",
                    "        pm.expect(responseJson).to.have.property('github_configured');",
                    "        pm.expect(responseJson).to.have.property('sync_ready');",
                    "        pm.expect(responseJson).to.have.property('configuration_status');",
                    "    }",
                    "    ",
                    "    // Models validation endpoint validation",
                    "    if (url.includes('/api/models/validate') && pm.request.method === 'GET') {",
                    "        pm.expect(responseJson).to.have.property('valid');",
                    "        pm.expect(responseJson).to.have.property('models_checked');",
                    "        pm.expect(responseJson).to.have.property('compatible_pairs');",
                    "        pm.expect(responseJson).to.have.property('incompatible_pairs');",
                    "    }",
                    "});",
                    "",
                    "// Specific validation for successful sync operations",
                    "pm.test('Successful sync should have proper counts', function () {",
                    "    const responseJson = pm.response.json();",
                    "    const url = pm.request.url.toString();",
                    "    ",
                    "    if (url.includes('/api/models/sync') && pm.response.code === 200 && responseJson.success) {",
                    "        pm.expect(responseJson.models_synced).to.be.a('number');",
                    "        pm.expect(responseJson.tokenizers_synced).to.be.a('number');",
                    "        pm.expect(responseJson.duration_seconds).to.be.a('number');",
                    "        pm.expect(responseJson.duration_seconds).to.be.above(0);",
                    "    }",
                    "});",
                    "",
                    "// Configuration error detection",
                    "pm.test('Configuration errors should provide helpful details', function () {",
                    "    const responseJson = pm.response.json();",
                    "    ",
                    "    if (pm.response.code === 422) {",
                    "        pm.expect(responseJson.detail.errors).to.be.an('array');",
                    "        pm.expect(responseJson.detail.errors.length).to.be.above(0);",
                    "        pm.expect(responseJson.detail.message).to.include('configuration');",
                    "    }",
                    "});",
                    "",
                    "// Log response for debugging",
                    "console.log('Models API Response Status:', pm.response.status);",
                    "console.log('Models API Response Time:', pm.response.responseTime + 'ms');",
                    "",
                    "// Log response body for non-successful operations or POST operations",
                    "if (pm.response.code !== 200 || pm.request.method === 'POST') {",
                    "    console.log('Models API Response Body:', JSON.stringify(pm.response.json(), null, 2));",
                    "}",
                    "",
                    "// Set environment variables for chaining requests",
                    "if (pm.response.code === 200) {",
                    "    const responseJson = pm.response.json();",
                    "    const url = pm.request.url.toString();",
                    "    ",
                    "    // Store models count for use in subsequent requests",
                    "    if (url.includes('/api/models/status')) {",
                    "        pm.collectionVariables.set('models_count', responseJson.models_count);",
                    "        pm.collectionVariables.set('tokenizers_count', responseJson.tokenizers_count);",
                    "        pm.collectionVariables.set('github_configured', responseJson.github_configured);",
                    "    }",
                    "    ",
                    "    // Store sync results for validation",
                    "    if (url.includes('/api/models/sync') && responseJson.success) {",
                    "        pm.collectionVariables.set('last_sync_models', responseJson.models_synced);",
                    "        pm.collectionVariables.set('last_sync_tokenizers', responseJson.tokenizers_synced);",
                    "        pm.collectionVariables.set('last_sync_validated', responseJson.version_validated);",
                    "    }",
                    "}"
                ]
            }
        }
    ]
}
