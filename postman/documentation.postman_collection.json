{
	"info": {
		"_postman_id": "doc-api-collection-2025",
		"name": "Polymer NLP Extractor - DOCUMENTATION",
		"description": "Collection for testing the Documentation API endpoints that provide access to project documentation files, developer guides, and architecture documentation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "polymer-docs-api"
	},
	"item": [
		{
			"name": "List Documentation Files",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has documentation files\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('files');",
							"    pm.expect(jsonData).to.have.property('total_files');",
							"    pm.expect(jsonData.files).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Files have required properties\", function () {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.files.length > 0) {",
							"        const file = jsonData.files[0];",
							"        pm.expect(file).to.have.property('name');",
							"        pm.expect(file).to.have.property('title');",
							"        pm.expect(file).to.have.property('size');",
							"        pm.expect(file).to.have.property('url');",
							"    }",
							"});",
							"",
							"// Store first file name for subsequent requests",
							"if (pm.response.json().files.length > 0) {",
							"    pm.globals.set(\"first_doc_file\", pm.response.json().files[0].name);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{pnlp}}/api/docs",
					"host": [
						"{{pnlp}}"
					],
					"path": [
						"api",
						"docs"
					]
				},
				"description": "List all available documentation files in the docs/ directory with metadata including file size, modification date, and direct access URLs."
			},
			"response": []
		},
		{
			"name": "Get Documentation File (Markdown)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has content\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('content');",
							"    pm.expect(jsonData).to.have.property('filename');",
							"    pm.expect(jsonData).to.have.property('format');",
							"    pm.expect(jsonData.format).to.eql('markdown');",
							"});",
							"",
							"pm.test(\"Content is not empty\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.content).to.not.be.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{pnlp}}/api/docs/development_notes.md?format=markdown",
					"host": [
						"{{pnlp}}"
					],
					"path": [
						"api",
						"docs",
						"development_notes.md"
					],
					"query": [
						{
							"key": "format",
							"value": "markdown"
						}
					]
				},
				"description": "Retrieve a specific documentation file in Markdown format. Returns the raw markdown content with metadata."
			},
			"response": []
		},
