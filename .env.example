# === Core Application Settings ===
# Environment (development, staging, production)
ENVIRONMENT=development

# === Server Configuration ===
# Main API Server
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# External Service URLs (for centralized management)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
NEO4J_HOST=localhost
NEO4J_PORT=7687
GROBID_HOST=localhost
GROBID_PORT=8070

# === Database Configuration ===
# PostgreSQL Settings
POSTGRES_DB=polymer_extractor
POSTGRES_USER=pnlp_db_user
POSTGRES_PASSWORD=password_here

# Neo4j Settings  
NEO4J_USER=neo4j
NEO4J_PASSWORD=password_here
NEO4J_HTTP_PORT=7474
NEO4J_HTTPS_PORT=7473

# === Optional Admin Tools ===
# pgAdmin (PostgreSQL Web Interface)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# === Service Management ===
# GROBID is expected to run in Docker; local GROBID_PATH is not required by default.

# === Server Management ===
SERVER_STARTUP_TIMEOUT=30
SERVER_SHUTDOWN_TIMEOUT=15
AUTO_RESTART_SERVICES=true
FORCE_KILL_ON_EXIT=true

# === Storage Configuration ===
# Primary storage backend: local | appwrite | s3
STORAGE_BACKEND=local
STORAGE_PATH=./workspace/public

# Multi-backend support (comma-separated list of active backends)
# Example: "local,appwrite" for local primary with Appwrite backup
# Example: "appwrite,s3" for Appwrite primary with S3 backup
STORAGE_BACKENDS_ACTIVE=local

# Storage routing strategy: primary | replica | failover | sync
# - primary: Use only primary backend
# - replica: Write to all, read from primary
# - failover: Switch to backup if primary fails
# - sync: Keep all backends synchronized
STORAGE_STRATEGY=primary

# For Appwrite storage (if appwrite in STORAGE_BACKENDS_ACTIVE)
APPWRITE_STORAGE_ENDPOINT=https://your-appwrite-endpoint.com/v1
APPWRITE_STORAGE_PROJECT_ID=your-project-id
APPWRITE_STORAGE_API_KEY=your_api_key_here
APPWRITE_ENABLED=false

# For S3 storage (if s3 in STORAGE_BACKENDS_ACTIVE)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT_URL=  # Optional for S3-compatible services
S3_ENABLED=false

# === Feature Flags ===
USE_POSTGRESQL_DB=true    # Primary relational database
USE_NEO4J_DB=true        # Primary graph database
USE_GROBID=true          # Document processing service

# === External API Keys (SENSITIVE) ===
WANDB_API_KEY=your_wandb_api_key_here
HF_TOKEN=your_huggingface_token_here
GITHUB_TOKEN=your_github_token_here

# === Processing Configuration ===
MAX_WORKERS=4
BATCH_SIZE=16
MAX_SEQUENCE_LENGTH=512

# === Development/Debug Settings ===
DEBUG=true
LOG_LEVEL=INFO

# === Optional: Database Encryption ===
# For production, consider encrypting databases
DB_ENCRYPTION_KEY=your_encryption_key_here

# === GROBID Configuration ===
GROBID_API_URL=http://${GROBID_HOST:-localhost}:${GROBID_PORT:-8070}/api
GROBID_VERSION=0.8.2

# === PostgreSQL Configuration ===
# Optional single DSN string (overrides host/port/db fields if set)
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection pooling (optional)
POSTGRES_MIN_CONN=1
POSTGRES_MAX_CONN=10
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_APPLICATION_NAME=polymer-nlp-extractor

# === Neo4j Configuration ===
NEO4J_URI=bolt://${NEO4J_HOST:-localhost}:${NEO4J_PORT:-7687}
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_ENCRYPTION=false
NEO4J_TRUST_ALL=false

# === Feature flags / routing ===
DATA_BACKEND=postgres     # postgres | appwrite (temporary switch during migration)
GRAPH_BACKEND=neo4j       # neo4j | disabled

# === Model Asset Sourcing (Read-Only in Services) ===
# GitHub repository containing models - requires GITHUB_TOKEN for private repos
MODELS_REPOSITORY_URL=https://github.com/dhanushmallu/polymer_nlp_models.git
TOKENIZERS_REMOTE_URL=https://github.com/dhanushmallu/polymer_nlp_models.git
FINETUNED_REMOTE_URL=https://github.com/dhanushmallu/polymer_nlp_models.git
MODELS_ROOT=./workspace/public/models
MODELS_VERSION=1.0

# GitHub authentication for private repository access
# Create a Personal Access Token with 'repo' scope at: https://github.com/settings/tokens
# For private repos, this token is REQUIRED
GITHUB_TOKEN=your_github_personal_access_token_here

# === Knowledge Graph Configuration ===
KG_INFERENCE_ENABLED=false    # Default: false until Phase 3
KG_CACHE_TTL_SEC=3600

# === Migration Helpers ===
MIGRATION_OUTPUT_DIR=./workspace/migration_output