# === Core Application Settings ===
# Environment (development, staging, production)
ENVIRONMENT=development

# === Appwrite Configuration (SENSITIVE) ===
# These should NEVER be committed to version control
APPWRITE_PROJECT_ID=polymer-nlp-extractor
APPWRITE_API_KEY=stan************************************************16f
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_DATABASE_ID=polymer-nlp-extractor-db
APPWRITE_BUCKET_ID=polymer-nlp-extractor-bucket

# Feature flags
USE_APPWRITE=true
USE_APPWRITE_DB=true

# === External API Keys (SENSITIVE) ===
WANDB_API_KEY=5bd1************************************************ef7a
HF_TOKEN=hf_m************************************************jXrV

# === Processing Configuration ===
MAX_WORKERS=4
BATCH_SIZE=16
MAX_SEQUENCE_LENGTH=512

# === Development/Debug Settings ===
DEBUG=true
LOG_LEVEL=INFO

# === Optional: Database Encryption ===
# For production, consider encrypting SQLite database
DB_ENCRYPTION_KEY=@7Ab************************************************84p2U

# === GROBID Configuration ===
GROBID_API_URL=http://localhost:8070/api
GROBID_VERSION=0.8.2

# === PostgreSQL Configuration ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polymer_extractor
POSTGRES_USER=polymer
POSTGRES_PASSWORD=poly************************************************word
# Optional single DSN string (overrides host/port/db fields if set)
POSTGRES_DSN=post************************************************ctor

# Connection pooling (optional)
POSTGRES_MIN_CONN=1
POSTGRES_MAX_CONN=10
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_APPLICATION_NAME=polymer-nlp-extractor

# === Neo4j Configuration ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4************************************************word
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_ENCRYPTION=false
NEO4J_TRUST_ALL=false

# === Feature flags / routing ===
DATA_BACKEND=postgres     # postgres | appwrite (temporary switch during migration)
GRAPH_BACKEND=neo4j       # neo4j | disabled